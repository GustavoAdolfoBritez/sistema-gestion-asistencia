# =====================================================================
# Variables de entorno del BACKEND
# Copiá este archivo a `.env` y completá los valores reales.
# Nunca versionés `.env` ni secretos reales.
# Validación: src/config/env.ts (Zod).
# =====================================================================

# Puerto HTTP. En Render/Heroku se inyecta solo; vacío o ausente = 4000.
PORT=4000

# development | production | test
NODE_ENV=development

# Cadena de conexión Postgres (Supabase → Settings → Database → URI).
# Preferí el pooler (puerto 6543) en entornos cloud.
SUPABASE_DB_URL=postgresql://postgres:TU_PASSWORD@db.TU_PROYECTO.supabase.co:5432/postgres

# URL del proyecto Supabase (Settings → API).
SUPABASE_URL=https://TU_PROYECTO.supabase.co

# Service role key (Settings → API). Solo backend; nunca en el frontend.
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY

# Secretos JWT (mínimo 16 caracteres; usá valores distintos por entorno).
JWT_SECRET=cambia_este_secreto_access_min_16
JWT_REFRESH_SECRET=cambia_este_secreto_refresh_min_16

# TTLs opcionales (defaults: 30 min access / 7 días refresh).
# JWT_EXP_MIN=30
# JWT_REFRESH_EXP_DAYS=7

# Orígenes CORS permitidos, separados por coma.
# En development se agregan localhost:5173/4173 automáticamente.
# En production DEBE incluir la URL del frontend (ej. Vercel).
# CORS_ORIGINS=https://tu-frontend.vercel.app

# Nivel de log: fatal | error | warn | info | debug | trace
# LOG_LEVEL=info

# true/1 expone detalle de errores 500 al cliente (solo útil en debug).
# En production el default es false.
# EXPOSE_ERROR_DETAILS=false

# Timeout de statements SQL en ms (default 15000).
# DB_STATEMENT_TIMEOUT_MS=15000

# ---------------------------------------------------------------------
# Frontend (carpeta frontend/): ver frontend/env.example
#   VITE_API_URL=https://tu-api.onrender.com/api
#   VITE_IS_DEMO=true   # solo entorno sandbox de demostración
# ---------------------------------------------------------------------
