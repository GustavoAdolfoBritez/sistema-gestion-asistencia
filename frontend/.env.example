# Copiar a `.env.local` (desarrollo) o definir en el dashboard de Vercel.
# Vite solo expone variables con prefijo VITE_.

# URL base de la API (incluye el path /api).
# Desarrollo local típico:
# VITE_API_URL=http://localhost:4000/api
#
# Demo pública (Render):
VITE_API_URL=https://sistema-gestion-asistencia.onrender.com/api

# Solo para el despliegue de DEMO (entorno sandbox aislado).
# En el sistema real esta variable NO debe definirse.
# Habilita el selector de credenciales de prueba en la pantalla de Login.
# VITE_IS_DEMO=true
